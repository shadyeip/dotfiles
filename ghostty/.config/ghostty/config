# Theme
theme = Catppuccin Mocha

# Font
font-size = 14
# A Nerd Font is required for the icons in Neovim, Starship and tmux to render
# (they show as boxes otherwise). This font must be installed on THIS machine —
# the one Ghostty runs on — even when you SSH elsewhere, because the local
# terminal draws the glyphs. Install with: brew install --cask font-jetbrains-mono-nerd-font
font-family = JetBrainsMono Nerd Font

# Window
window-padding-x = 8
window-padding-y = 8

# Cursor
cursor-style = block
cursor-style-blink = false

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Ctrl+V to paste, Ctrl+C to copy.
# `performable:` on Ctrl+C means it only copies when there's a selection;
# with no selection the keypress falls through to the terminal as SIGINT,
# so Ctrl+C still interrupts running programs as usual.
keybind = ctrl+v=paste_from_clipboard
keybind = performable:ctrl+c=copy_to_clipboard

# Shell
shell-integration = zsh
