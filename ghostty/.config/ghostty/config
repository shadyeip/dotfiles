# Theme
theme = Catppuccin Mocha

# Font
font-size = 14
# No font install needed: Ghostty ships with JetBrains Mono and supplies Nerd
# Font symbols from a bundled fallback, so the agnoster prompt, tmux, and
# Neovim icons render out of the box. To use a different font, install it and
# uncomment:
# font-family = JetBrainsMono Nerd Font

# Window
window-padding-x = 8
window-padding-y = 8

# Cursor
cursor-style = block
cursor-style-blink = false

# Clipboard
clipboard-read = allow
clipboard-write = allow

# Shell
shell-integration = zsh
